{
  "name": "@beav/core",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./worker-events": {
      "types": "./dist/worker-events.d.ts",
      "default": "./dist/worker-events.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./task-store": {
      "types": "./dist/task-store.d.ts",
      "default": "./dist/task-store.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine.d.ts",
      "default": "./dist/state-machine.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/better-sqlite3": "^7.6.13"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.3.6"
  }
}
