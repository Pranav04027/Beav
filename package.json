{
  "name": "beav",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --check",
    "start": "node packages/cli/dist/index.js start",
    "setup": "node packages/cli/dist/index.js setup",
    "status": "node packages/cli/dist/index.js status",
    "logs": "node packages/cli/dist/index.js logs",
    "test": "node scripts/build.mjs && node --test packages/*/test/*.test.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
